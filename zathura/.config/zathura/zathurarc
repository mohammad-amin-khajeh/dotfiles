set statusbar-h-padding 0
set statusbar-v-padding 0
set guioptions ""
set font "jetbrainsmono nf 10"
set default-bg "#000"
set highlight-fg "#000"
set highlight-active-color "rgba(0,200,0,0.5)"
set highlight-color "rgba(100,200,0,0.5)"
set index-bg "#000"
set completion-bg "#000"
set inputbar-bg "#000"
set selection-clipboard clipboard
map u scroll half-up
map d scroll half-down
map b scroll full-up
map f scroll full-down
map l follow
map <C-l> display_link
map D toggle_page_mode
map r reload
map R rotate
map K zoom in
map J zoom out
map i recolor
map g goto top
map O feedkeys ":exec zathura $FILE<Return>"
