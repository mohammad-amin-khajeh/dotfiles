# show last dunst notification
# [n]otification [s]how
super + ctrl + s; n; s
  dunstctl history-pop

# dismiss last dunst notification
# [n]otification [h]ide
super + ctrl + s; n; h
  dunstctl close-all

# anki card
super + ctrl + s; a; c
  xdotool search --name "Add" windowactivate;\
  sleep 0.1;\
  xdotool key ctrl+v;\
  sleep 0.1;\
  xdotool key Tab

# anki image
super + ctrl + s; a; i
  xdotool search --name "Add" windowactivate; sleep 0.1; xdotool key ctrl+shift+o

# [d]ownload url
super + ctrl + s; d
  wget -P ~/Downloads -c "$(xclip -o -sel c)"

super + ctrl + s; b; m
