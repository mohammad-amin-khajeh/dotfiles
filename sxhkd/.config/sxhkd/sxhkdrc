# [t]imer [s]tart
super + ctrl + s; t; s
  timer.sh

# [t]imer [e]nd
super + ctrl + s; t; e
  timer.sh kill

# [r]ofi[m]oji
super + ctrl + s; r; m
  rofimoji

# [r]ofi [d]esktop
super + ctrl + s; r; d
