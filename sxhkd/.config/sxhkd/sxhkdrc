# update dwmblocks-async's volume module
KP_{Enter,Add}
  pamixer --{increase,decrease} 1 && kill -44 $(pidof dwmblocks)

# update dwmblocks-async's volume module
XF86Audio{Raise,Lower}Volume
  pamixer --{increase,decrease} 2 && kill -44 $(pidof dwmblocks)

# toggle the last audio stream
KP_Subtract
  playerctl --list-all | tail -n 1 | xargs playerctl play-pause --player

XF86MonBrightness{Down,Up}
  brightnessctl set {1-%, 1+%}

# f4 on my laptop
XF86AudioMicMute
  timer.sh

# f1 on my laptop
XF86AudioMute
  timer.sh kill

super + r
  rofi -show run

super + v
  rofi-gpaste

# snap the "whole" screen and copy it to clipboard
super + shift + s; w
  current_date=$(date +%Y-%m-%d\ %H-%M-%S) && \
  file="${HOME}/Pictures/screenshots/${current_date}.png" && \
  shotgun "$file" && \
  echo "file://${file}" | \
  xclip -sel c -t text/uri-list && \
  dunstify 📸 "screenshot taken" -t 1200

# screenshot a "region" and copy it to clipboard
super + shift + s; r
  current_date=$(date +%Y-%m-%d\ %H-%M-%S) && \
  file="${HOME}/Pictures/screenshots/${current_date}.png" && \
  region=$(hacksaw) && \
  shotgun -g "$region" "$file" && \
  echo "file://${file}" | \
  xclip -sel c -t text/uri-list


# "copy" a region to clipboard
super + shift + s; c
  region=$(hacksaw) && \
  shotgun -g $region -f png /tmp/tmp.png && \
  echo "file:///tmp/tmp.png" | \
  xclip -sel c -t text/uri-list

super + w
  "$term" -c termFloat -e wlctl

# toggle screenkey
super + alt + s
  pgrep screenkey && pkill screenkey || screenkey

super + alt + l
  slock

##########Quality of life binds##########

super + ctrl + s; a; m
  amount.sh

# tor connect
super + ctrl + s; t; c
  toggle_tor.sh


super + ctrl + s; w
  wallpaper.sh

super + ctrl + s; o
  output_switcher.sh

super + ctrl + s; b; b
  open_book.sh

super + ctrl + s; y; {v,m}
  yt-dlp.sh {v,m} "$(xclip -o -sel c)"

# [t]otal [t]ime
super + ctrl + s; t; t
  notify-send "study time:" "$(today_time.sh ~/Documents/coding_progress.md)" -t 1000

super + ctrl + s; c; p
  "$term" -c termFloat -e "$EDITOR" ~/Documents/coding_progress.md

super + ctrl + s; c; c
  qalculate-gtk --title qalcFloat

# Calcurse Open
super + ctrl + s; c; o
